">#include &lt;bits/stdc++.h&gt;
using namespace std;

int main() {
	int n, q;
	cin &gt;&gt; n &gt;&gt; q;
	vector&lt;int&gt; L(n), R(n);
	for (int i =3D 1; i &lt; n; i++) cin &gt;&gt; L[i];
	for (int i =3D 0; i &lt; n - 1; i++) cin &gt;&gt; R[i];
	vector&lt;int&gt; A =3D L, B =3D R;
	for (int i =3D n - 2; i &gt;=3D 0; i--) A[i] =3D min(A[i], A[i + 1]);
	for (int i =3D 1; i &lt; n; i++) B[i] =3D min(B[i], B[i - 1]);
	while (q--) {
		int s, t;
		cin &gt;&gt; s &gt;&gt; t;
		s--; t--;
		if (s &lt; t) {
			int ans =3D R[s];
			if (s &gt; 0) ans =3D min(ans, L[s] + B[s - 1]);
			cout &lt;&lt; ans &lt;&lt; '\n';
		}
		else {
			int ans =3D L[s];
			if (s &lt; n - 1) ans =3D min(ans, R[s] + A[s + 1]);
			cout &lt;&lt; ans &lt;&lt; '\n';
		}
	}
}
